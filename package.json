{
    "name": "react-native-scroll-track",
    "version": "2.0.2",
    "description": "A customizable, interactive scroll indicator for React Native with drag and tap functionality",
    "main": "lib/index.js",
    "module": "lib/index.js",
    "types": "lib/index.d.ts",
    "react-native": "lib/index.js",
    "files": [
        "lib",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "clean": "rimraf lib",
        "prepare": "npm run clean && npm run build",
        "prepublishOnly": "npm run build",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "keywords": [
        "react-native",
        "scrollbar",
        "scroll indicator",
        "gesture",
        "flatlist",
        "draggable scrollbar",
        "scroll track",
        "animated scroll"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dangervalentine/react-native-scroll-track.git"
    },
    "homepage": "https://github.com/dangervalentine/react-native-scroll-track#readme",
    "bugs": {
        "url": "https://github.com/dangervalentine/react-native-scroll-track/issues"
    },
    "peerDependencies": {
        "react": ">=19.0.0",
        "react-native": ">=0.78.0",
        "react-native-gesture-handler": ">=2.24.0",
        "react-native-reanimated": ">=4.0.0",
        "react-native-worklets": ">=0.5.0"
    },
    "devDependencies": {
        "@react-native/babel-preset": "0.86.3",
        "@react-native/jest-preset": "^0.86.3",
        "@testing-library/react-native": "^13.3.0",
        "@types/jest": "^29.0.0",
        "@types/react": "^19.0.0",
        "jest": "^29.0.0",
        "jest-environment-jsdom": "^30.0.5",
        "react": "19.2.3",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "~4.5.1",
        "react-native-worklets": "~0.10.1",
        "react-test-renderer": "19.2.3",
        "rimraf": "^3.0.2",
        "typescript": "^5.0.0"
    },
    "license": "MIT",
    "author": "Danger Valentine"
